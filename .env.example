# =============================================================================
# Voltiq — local development configuration
# Copy this file to .env and adjust values. NEVER commit .env
# =============================================================================
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver

# -----------------------------------------------------------------------------
# Database
# PostgreSQL is the production database. Create the DB in pgAdmin 4 first.
# For a quick local start without PostgreSQL use DB_ENGINE=sqlite.
# -----------------------------------------------------------------------------
DB_ENGINE=postgres
DB_NAME=voltiq
DB_USER=postgres
DB_PASSWORD=your-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------
SITE_NAME=Voltiq
SITE_URL=http://127.0.0.1:8000
SUPPORT_EMAIL=support@voltiq.com.np
DEFAULT_FROM_EMAIL=Voltiq <no-reply@voltiq.com.np>
TIME_ZONE=Asia/Kathmandu
FREE_SHIPPING_THRESHOLD=10000
DEFAULT_SHIPPING_FEE=250
PAYMENT_TIMEOUT_MINUTES=30

# -----------------------------------------------------------------------------
# Email — leave EMAIL_HOST empty to print emails to the console in development
# Gmail example (2-Step Verification must be on; use a 16-character app password
# with the spaces removed, never your normal Google password):
#   EMAIL_HOST=smtp.gmail.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=True
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=abcdefghijklmnop
#   DEFAULT_FROM_EMAIL=Voltiq <you@gmail.com>
# Verification and password-reset mail is sent to the address on the account,
# so each customer receives it at the mailbox they registered with.
# -----------------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# -----------------------------------------------------------------------------
# Payments
# PAYMENT_SIMULATION=True allows testing checkout without live credentials.
# Set to False and add real/sandbox keys for actual gateway redirects.
# -----------------------------------------------------------------------------
PAYMENT_SIMULATION=True

# eSewa ePay v2 — public sandbox credentials for testing
ESEWA_MODE=sandbox
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
# Production: https://epay.esewa.com.np/api/epay/main/v2/form
ESEWA_INIT_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
# Production: https://esewa.com.np/api/epay/transaction/status/
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/

# Khalti ePayment — get sandbox keys at https://docs.khalti.com
KHALTI_MODE=sandbox
KHALTI_SECRET_KEY=
KHALTI_INIT_URL=https://dev.khalti.com/api/v2/epayment/initiate/
KHALTI_LOOKUP_URL=https://dev.khalti.com/api/v2/epayment/lookup/
KHALTI_WEBSITE_URL=http://127.0.0.1:8000

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# Bank transfer instructions (shown to customers after checkout)
# The UI warns customers when BANK_ACCOUNT_NUMBER is blank.
# -----------------------------------------------------------------------------
BANK_NAME=Nabil Bank
BANK_ACCOUNT_NAME=Voltiq Electronics Pvt. Ltd.
BANK_ACCOUNT_NUMBER=
BANK_BRANCH=Durbar Marg, Kathmandu
BANK_SWIFT=
BANK_SUPPORT_NOTE=Email the deposit slip to support@voltiq.com.np quoting your order number.

# -----------------------------------------------------------------------------
# Uploads (avatars, product images)
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=5

# -----------------------------------------------------------------------------
# Production security (enable behind HTTPS)
# -----------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
